{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots" : ["./node_modules/@types", "./types"]
  },
  "exclude": ["vitest.config.ts", "node_modules", "dist"]
}